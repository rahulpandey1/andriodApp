<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirstAndriodApp.Pages.TracingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pageModels="clr-namespace:FirstAndriodApp.PageModels"
    Title="✏️ Alphabet Tracing">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" Background="{StaticResource GamePageGradient}">
        <Label
            Grid.Row="0"
            Text="✏️ Trace the Letter!"
            Style="{StaticResource GameTitleLabel}" />

        <Label
            Grid.Row="1"
            Text="{Binding StatusText}"
            Style="{StaticResource GameStatusLabel}"
            Margin="0,0,0,10"/>

        <!-- Tracing Area -->
        <Border Grid.Row="2" BackgroundColor="White" Margin="20" StrokeThickness="3" Stroke="{StaticResource GameLavender}">
            <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#20A66CFF" Offset="0,4" Opacity="0.2" Radius="10" />
            </Border.Shadow>
            <Grid>
                <!-- Background Letter Template -->
                <Image 
                    Source="{Binding CurrentLetterImage}" 
                    Aspect="AspectFit" 
                    Opacity="0.2" 
                    HorizontalOptions="Fill" 
                    VerticalOptions="Fill" />
                    
                <!-- Drawing Canvas -->
                <GraphicsView
                    x:Name="DrawingCanvas"
                    StartInteraction="DrawingCanvas_StartInteraction"
                    DragInteraction="DrawingCanvas_DragInteraction"
                    EndInteraction="DrawingCanvas_EndInteraction"
                    InputTransparent="False"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />
            </Grid>
        </Border>

        <HorizontalStackLayout Grid.Row="3" Spacing="20" HorizontalOptions="Center" Margin="0,16">
            <Button
                Text="🔄 Reset"
                Clicked="Reset_Clicked"
                Style="{StaticResource GameResetButton}" />
            
            <Button
                Text="✅ Done"
                Command="{Binding CompleteLetterCommand}"
                Style="{StaticResource GameDoneButton}" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
