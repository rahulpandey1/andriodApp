<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirstAndriodApp.Pages.AnimalMatchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FirstAndriodApp.Models"
    Title="🐾 Animal Sounds">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="24" Background="{StaticResource GamePageGradient}">
        <Label
            Grid.Row="0"
            Text="🐾 Which animal makes this sound?"
            Style="{StaticResource GameTitleLabel}"
            FontSize="24" />

        <Label
            Grid.Row="1"
            Margin="0,0,0,20"
            Text="{Binding StatusText}"
            Style="{StaticResource GameStatusLabel}" />

        <!-- Sound Button -->
        <Border
            Grid.Row="2"
            HeightRequest="120"
            WidthRequest="120"
            StrokeThickness="4"
            Stroke="{StaticResource GamePrimary}"
            BackgroundColor="White"
            HorizontalOptions="Center"
            Margin="0,0,0,30">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="60" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#40FF6B8A" Offset="0,4" Opacity="0.3" Radius="12" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding PlayTargetSoundCommand}" />
            </Border.GestureRecognizers>
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                <Label Text="🔊" FontSize="42" HorizontalOptions="Center" />
                <Label Text="Tap me!" FontSize="11" TextColor="{StaticResource GamePrimary}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- Animal Grid -->
        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Animals}"
            SelectionMode="None"
            VerticalOptions="Center">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="16" VerticalItemSpacing="16" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MatchItem">
                    <Border
                        StrokeThickness="0"
                        BackgroundColor="White"
                        HeightRequest="140"
                        Padding="10">
                        <Border.Shadow>
                            <Shadow Brush="#20000000" Offset="0,4" Opacity="0.15" Radius="10" />
                        </Border.Shadow>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CheckAnswerCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Image
                                Source="{Binding ObjectImage}"
                                HeightRequest="90"
                                WidthRequest="90"
                                Aspect="AspectFit" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
