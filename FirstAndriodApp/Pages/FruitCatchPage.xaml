<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirstAndriodApp.Pages.FruitCatchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pageModels="clr-namespace:FirstAndriodApp.PageModels"
    Title="🍎 Fruit Catch">

    <Grid RowDefinitions="Auto,*" Background="{StaticResource GameSkyGradient}">
        <Grid Grid.Row="0" Padding="12" ColumnDefinitions="*,Auto">
             <Label Text="{Binding StatusText}" Style="{StaticResource GameTitleLabel}" HorizontalOptions="Start" FontSize="22" />
             <Border Grid.Column="1" BackgroundColor="#40FFFFFF" StrokeThickness="0" Padding="10,6">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Label Text="{Binding Score, StringFormat='⭐ Score: {0}'}" Style="{StaticResource GameScoreLabel}" VerticalOptions="Center" />
             </Border>
        </Grid>
        
        <!-- Game Area -->
        <AbsoluteLayout Grid.Row="1" x:Name="GameArea">
            <AbsoluteLayout.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="PanGestureRecognizer_PanUpdated" />
            </AbsoluteLayout.GestureRecognizers>

            <!-- Basket -->
            <Image 
                Source="basket.png"
                HeightRequest="60"
                WidthRequest="80"
                TranslationX="{Binding BasketX}"
                TranslationY="{Binding BasketY}" />

            <!-- Falling Items -->
            <BindableLayout.ItemsSource>
                <Binding Path="Items" />
            </BindableLayout.ItemsSource>
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pageModels:FallingItem">
                     <Image 
                        Source="{Binding Image}"
                        HeightRequest="50"
                        WidthRequest="50"
                        TranslationX="{Binding X}"
                        TranslationY="{Binding Y}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </AbsoluteLayout>
    </Grid>
</ContentPage>
