<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirstAndriodApp.Pages.MatchItPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FirstAndriodApp.Models"
    Title="Match It">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16">
        <Label
            Grid.Row="0"
            Text="Drag the colored image to match its hollow picture"
            FontSize="18"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center" />

        <Label
            Grid.Row="1"
            Margin="0,8,0,12"
            Text="{Binding StatusText}"
            FontSize="16"
            HorizontalTextAlignment="Center" />

        <Button
            Grid.Row="2"
            Text="Reset"
            HorizontalOptions="Center"
            Clicked="Reset_Clicked" />

        <!-- Game area with overlay drag layer -->
        <Grid Grid.Row="3">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Frame Grid.Column="0" Padding="10" CornerRadius="12" BackgroundColor="#FFF8F8F8">
                    <VerticalStackLayout x:Name="LeftStack" Spacing="12" BindableLayout.ItemsSource="{Binding LeftItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MatchItem">
                                <Border
                                    Padding="8"
                                    BackgroundColor="White"
                                    Stroke="#E0E0E0"
                                    StrokeThickness="2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Image
                                        Source="{Binding ObjectImage}"
                                        HeightRequest="90"
                                        WidthRequest="90"
                                        Aspect="AspectFit">
                                        <Image.GestureRecognizers>
                                            <PanGestureRecognizer PanUpdated="Left_PanUpdated" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" Padding="10" CornerRadius="12" BackgroundColor="#FFF0F0F0">
                    <VerticalStackLayout x:Name="RightStack" Spacing="12" BindableLayout.ItemsSource="{Binding RightItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MatchItem">
                                <Border
                                    Padding="8"
                                    BackgroundColor="#FFEFEFEF"
                                    Stroke="#D0D0D0"
                                    StrokeThickness="2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Image
                                        Source="{Binding ShadowImage}"
                                        HeightRequest="90"
                                        WidthRequest="90"
                                        Aspect="AspectFit" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Overlay used to render the dragged image above everything -->
            <AbsoluteLayout x:Name="DragOverlay" InputTransparent="True" />
        </Grid>
    </Grid>
</ContentPage>
