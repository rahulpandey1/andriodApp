<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirstAndriodApp.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FirstAndriodApp.Models"
    xmlns:pageModels="clr-namespace:FirstAndriodApp.PageModels"
    Title="Games">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="16" Background="{StaticResource GamePageGradient}">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="0,10,0,0" x:Name="HeaderLayout">
            <Label
                Text="🎮 My Games"
                FontSize="32"
                FontAttributes="Bold"
                FontFamily="OpenSansSemibold"
                TextColor="{StaticResource GamePrimary}"
                HorizontalOptions="Center" />
            <Label
                Text="Pick a game and have fun!"
                FontSize="14"
                TextColor="{StaticResource GameText}"
                Opacity="0.6"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            x:Name="GamesCollectionView"
            ItemsSource="{Binding Games}"
            SelectionMode="Single"
            SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="14" VerticalItemSpacing="14" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:GameTile">
                    <Border
                        Padding="0"
                        StrokeThickness="0"
                        BackgroundColor="{Binding BackgroundColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#30000000" Offset="0,6" Radius="16" Opacity="0.3" />
                        </Border.Shadow>
                        
                        <Grid RowDefinitions="*,Auto" HeightRequest="175" Padding="0">
                            <!-- Gradient Overlay -->
                            <BoxView Grid.RowSpan="2" CornerRadius="24" Opacity="0.1" BackgroundColor="White" />
                            <BoxView Grid.RowSpan="2" CornerRadius="24">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0.0" />
                                        <GradientStop Color="#20000000" Offset="1.0" />
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>

                            <Grid RowDefinitions="*,Auto" Grid.RowSpan="2" Padding="16">
                                <!-- Icon/Image -->
                                <Image Source="{Binding Image}" Aspect="AspectFit" VerticalOptions="Center" HorizontalOptions="Center" HeightRequest="80" WidthRequest="80" />
                                
                                <!-- Lock Overlay -->
                                <Grid BackgroundColor="#90000000" IsVisible="{Binding IsLocked}" VerticalOptions="Fill" HorizontalOptions="Fill" Grid.RowSpan="2" Margin="-16">
                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                        <Label Text="🔒" FontSize="36" HorizontalOptions="Center" />
                                        <Label Text="Locked" TextColor="White" FontSize="12" HorizontalOptions="Center" Opacity="0.8" />
                                    </VerticalStackLayout>
                                </Grid>
    
                                <VerticalStackLayout Grid.Row="1" Spacing="2">
                                    <Label Text="{Binding Title}" TextColor="White" FontSize="17" FontAttributes="Bold" FontFamily="OpenSansSemibold" HorizontalOptions="Center" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Subtitle}" TextColor="White" FontSize="12" HorizontalOptions="Center" Opacity="0.9" />
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
