<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirstAndriodApp.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FirstAndriodApp.Models"
    xmlns:pageModels="clr-namespace:FirstAndriodApp.PageModels"
    Title="Games">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12" BackgroundColor="{StaticResource GameBackground}">
        <Label
            Grid.Row="0"
            Text="My Games"
            Style="{StaticResource GameTitleLabel}" />

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Games}"
            SelectionMode="Single"
            SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="15" VerticalItemSpacing="15" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:GameTile">
                    <Border
                        Padding="0"
                        StrokeThickness="0"
                        BackgroundColor="{Binding BackgroundColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="5,5" Radius="10" Opacity="0.2" />
                        </Border.Shadow>
                        
                        <Grid RowDefinitions="*,Auto" HeightRequest="160" Padding="15">
                            <!-- Icon/Image -->
                            <Image Source="{Binding Image}" Aspect="AspectFit" VerticalOptions="Center" HorizontalOptions="Center" HeightRequest="70" />
                            
                            <!-- Lock Overlay -->
                            <Grid BackgroundColor="#80000000" IsVisible="{Binding IsLocked}" VerticalOptions="Fill" HorizontalOptions="Fill" Grid.RowSpan="2" Margin="-15">
                                <Image Source="lock_icon.png" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center" />
                            </Grid>

                            <StackLayout Grid.Row="1" Spacing="4">
                                <Label Text="{Binding Title}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Subtitle}" TextColor="White" FontSize="12" HorizontalOptions="Center" Opacity="0.95" />
                            </StackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
