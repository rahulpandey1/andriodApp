<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirstAndriodApp.Pages.ConnectDotsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pageModels="clr-namespace:FirstAndriodApp.PageModels"
    Title="🔢 Number Connect">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" Background="{StaticResource GamePageGradient}">
        <Label
            Grid.Row="0"
            Text="🔢 Connect the Dots!"
            Style="{StaticResource GameTitleLabel}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Label
                Text="{Binding StatusText}"
                Style="{StaticResource GameStatusLabel}"
                Margin="0,0,0,10"/>
            <Button
                Grid.Column="1"
                Text="🔄 Reset"
                HorizontalOptions="End"
                Clicked="Reset_Clicked"
                Style="{StaticResource GameResetButton}"
                HeightRequest="38"
                FontSize="12" />
        </Grid>
        
        <!-- Game Area -->
        <Border Grid.Row="2" BackgroundColor="White" Margin="10" StrokeThickness="3" Stroke="{StaticResource GameLime}">
            <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#20A8E063" Offset="0,4" Opacity="0.2" Radius="10" />
            </Border.Shadow>
            <Grid>
                <!-- Reveal Image -->
                <Image 
                    Source="{Binding RevealedImage}" 
                    Aspect="AspectFit" 
                    IsVisible="{Binding IsCompleted}" 
                    Opacity="0.8" />

                <!-- Drawing Canvas -->
                 <GraphicsView
                    x:Name="DrawingCanvas"
                    StartInteraction="DrawingCanvas_StartInteraction"
                    DragInteraction="DrawingCanvas_DragInteraction"
                    EndInteraction="DrawingCanvas_EndInteraction"
                    InputTransparent="False"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />

                <!-- Dot Overlay -->
                <AbsoluteLayout BindableLayout.ItemsSource="{Binding Dots}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pageModels:DotItem">
                           <Border
                               BackgroundColor="{StaticResource GameSuccess}"
                               StrokeThickness="3"
                               Stroke="White"
                               HeightRequest="42"
                               WidthRequest="42"
                               TranslationX="{Binding X}"
                               TranslationY="{Binding Y}">
                               <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                               <Border.Shadow>
                                   <Shadow Brush="#406BCB77" Offset="0,2" Opacity="0.3" Radius="4" />
                               </Border.Shadow>
                               <Label Text="{Binding Id}" TextColor="White" FontAttributes="Bold" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                           </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </AbsoluteLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
