<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirstAndriodApp.Pages.ConnectDotsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pageModels="clr-namespace:FirstAndriodApp.PageModels"
    Title="Number Connect">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" BackgroundColor="{StaticResource GameBackground}">
        <Label
            Grid.Row="0"
            Text="Connect the Dots!"
            Style="{StaticResource GameTitleLabel}" />

        <Label
            Grid.Row="1"
            Text="{Binding StatusText}"
            FontSize="16"
            HorizontalOptions="Center" 
            Margin="0,0,0,10"/>
        
        <!-- Game Area -->
        <Grid Grid.Row="2" BackgroundColor="White" Margin="10">
            <!-- Reveal Image -->
            <Image 
                Source="{Binding RevealedImage}" 
                Aspect="AspectFit" 
                IsVisible="{Binding IsCompleted}" 
                Opacity="0.8" />

            <!-- Drawing Canvas -->
             <GraphicsView
                x:Name="DrawingCanvas"
                StartInteraction="DrawingCanvas_StartInteraction"
                DragInteraction="DrawingCanvas_DragInteraction"
                EndInteraction="DrawingCanvas_EndInteraction"
                InputTransparent="False"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <!-- Dot Overlay -->
            <AbsoluteLayout BindableLayout.ItemsSource="{Binding Dots}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pageModels:DotItem">
                       <Border
                           BackgroundColor="#26de81"
                           StrokeThickness="2"
                           Stroke="White"
                           HeightRequest="40"
                           WidthRequest="40"
                           TranslationX="{Binding X}"
                           TranslationY="{Binding Y}">
                           <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape> 
                           <Label Text="{Binding Id}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                       </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </AbsoluteLayout>
        </Grid>

        <Button
            Grid.Row="1"
            Text="Reset"
            HorizontalOptions="End"
            Clicked="Reset_Clicked"
            Style="{StaticResource GameButton}"
            HeightRequest="40"
            FontSize="12" />
    </Grid>
</ContentPage>
