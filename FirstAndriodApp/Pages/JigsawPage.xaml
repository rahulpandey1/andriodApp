<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirstAndriodApp.Pages.JigsawPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pageModels="clr-namespace:FirstAndriodApp.PageModels"
    Title="Jigsaw Puzzle">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" BackgroundColor="{StaticResource GameBackground}">
        <Label
            Grid.Row="0"
            Text="Complete the Picture!"
            Style="{StaticResource GameTitleLabel}" />

        <Label
            Grid.Row="1"
            Text="{Binding StatusText}"
            FontSize="16"
            HorizontalOptions="Center" 
            Margin="0,0,0,10"/>

        <Button
            Grid.Row="1"
            Text="Reset"
            HorizontalOptions="End"
            Clicked="Reset_Clicked"
            Style="{StaticResource GameButton}"
            HeightRequest="40"
            FontSize="12" />

        <!-- Game Area -->
        <AbsoluteLayout x:Name="GameLayout" Grid.Row="2" BackgroundColor="#F0F0F0">
            <!-- Board Outline (Centered approx) -->
            <Border 
                AbsoluteLayout.LayoutBounds="20, 20, 300, 300"
                AbsoluteLayout.LayoutFlags="None"
                StrokeDashArray="5,5"
                Stroke="#CCC"
                StrokeThickness="2"
                BackgroundColor="White">
                <Label Text="Place Here" VerticalOptions="Center" HorizontalOptions="Center" TextColor="#DDD" FontSize="24" />
            </Border>

            <!-- Pieces Layer -->
            <!-- We need to bind pieces dynamically to AbsoluteLayout Children. 
                 BindableLayout works for Stack/Flex/Grid, but AbsoluteLayout is trickier.
                 We can use a BindableLayout inside an AbsoluteLayout with custom positioned items? 
                 No, standard BindableLayout creates a stack.
                 Solution: Code-behind rendering or a custom Layout behavior.
                 'GraphicsView' is good for this, but 'AbsoluteLayout' with Bindable behavior is easier for interactive controls.
                 I'll use a hack: BindableLayout in a Grid (Overlay), but items have TranslationX/Y bound to CurrentX/Y.
            -->
            
            <Grid AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
                <BindableLayout.ItemsSource>
                    <Binding Path="Pieces" />
                </BindableLayout.ItemsSource>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pageModels:JigsawPiece">
                        <Image
                            Source="{Binding Image}"
                            HeightRequest="{Binding Height}"
                            WidthRequest="{Binding Width}"
                            TranslationX="{Binding CurrentX}"
                            TranslationY="{Binding CurrentY}"
                            ZIndex="{Binding ZIndex}"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                            <Image.GestureRecognizers>
                                <PanGestureRecognizer PanUpdated="Piece_PanUpdated" />
                            </Image.GestureRecognizers>
                        </Image>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </Grid>
        </AbsoluteLayout>
    </Grid>
</ContentPage>
