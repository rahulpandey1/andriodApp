<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirstAndriodApp.Pages.JigsawPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pageModels="clr-namespace:FirstAndriodApp.PageModels"
    Title="🧩 Jigsaw Puzzle">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" Background="{StaticResource GamePageGradient}">
        <Label
            Grid.Row="0"
            Text="🧩 Complete the Picture!"
            Style="{StaticResource GameTitleLabel}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Label
                Text="{Binding StatusText}"
                Style="{StaticResource GameStatusLabel}"
                Margin="0,0,0,10"/>
            <Button
                Grid.Column="1"
                Text="🔄 Reset"
                HorizontalOptions="End"
                Clicked="Reset_Clicked"
                Style="{StaticResource GameResetButton}"
                HeightRequest="38"
                FontSize="12" />
        </Grid>

        <!-- Game Area -->
        <Border Grid.Row="2" BackgroundColor="#FFF8F6FF" StrokeThickness="0" Padding="4">
            <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#20A66CFF" Offset="0,4" Opacity="0.2" Radius="10" />
            </Border.Shadow>
            <AbsoluteLayout x:Name="GameLayout">
                <!-- Board Outline (Centered approx) -->
                <Border 
                    AbsoluteLayout.LayoutBounds="20, 20, 300, 300"
                    AbsoluteLayout.LayoutFlags="None"
                    StrokeDashArray="5,5"
                    Stroke="{StaticResource GameLavender}"
                    StrokeThickness="3"
                    BackgroundColor="White">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Label Text="📍 Place Here" VerticalOptions="Center" HorizontalOptions="Center" TextColor="#D0D0D0" FontSize="22" FontAttributes="Bold" />
                </Border>

                <!-- Pieces Layer -->
                <Grid AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
                    <BindableLayout.ItemsSource>
                        <Binding Path="Pieces" />
                    </BindableLayout.ItemsSource>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pageModels:JigsawPiece">
                            <Image
                                Source="{Binding Image}"
                                HeightRequest="{Binding Height}"
                                WidthRequest="{Binding Width}"
                                TranslationX="{Binding CurrentX}"
                                TranslationY="{Binding CurrentY}"
                                ZIndex="{Binding ZIndex}"
                                HorizontalOptions="Start"
                                VerticalOptions="Start">
                                <Image.GestureRecognizers>
                                    <PanGestureRecognizer PanUpdated="Piece_PanUpdated" />
                                </Image.GestureRecognizers>
                            </Image>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>
            </AbsoluteLayout>
        </Border>
    </Grid>
</ContentPage>
