<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FirstAndriodApp.Pages.BalloonPopPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pageModels="clr-namespace:FirstAndriodApp.PageModels"
    Title="🎈 Balloon Pop">

    <Grid RowDefinitions="Auto,*" Background="{StaticResource GameSkyGradient}">
        <VerticalStackLayout Grid.Row="0" Padding="16,12" Spacing="4">
            <Label
                Text="🎈 Balloon Pop!"
                Style="{StaticResource GameTitleLabel}" />
            <Label
                Text="{Binding StatusText}"
                Style="{StaticResource GameStatusLabel}" />
        </VerticalStackLayout>

        <!-- Game Area -->
        <AbsoluteLayout Grid.Row="1" x:Name="GameArea">
            <BindableLayout.ItemsSource>
                <Binding Path="Balloons" />
            </BindableLayout.ItemsSource>
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="pageModels:BalloonItem">
                    <Grid
                        HeightRequest="100"
                        WidthRequest="80"
                        TranslationX="{Binding X}"
                        TranslationY="{Binding Y}">
                         <Grid.GestureRecognizers>
                             <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PopBalloonCommand}"
                                CommandParameter="{Binding .}" />
                         </Grid.GestureRecognizers>
                        
                        <Image Source="{Binding Image}" Aspect="AspectFit" />
                        <Label Text="{Binding Number}" 
                               FontSize="26" 
                               FontAttributes="Bold" 
                               TextColor="White"
                               FontFamily="OpenSansSemibold"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" 
                               Margin="0,-10,0,0">
                            <Label.Shadow>
                                <Shadow Brush="#60000000" Offset="1,1" Radius="3" />
                            </Label.Shadow>
                        </Label>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </AbsoluteLayout>
    </Grid>
</ContentPage>
